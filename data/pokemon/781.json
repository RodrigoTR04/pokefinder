  "flavor_texts": [
    {
      "game": "sun",
      "text": "Swinging its massive anchor, it can KO Wailord in a single blow. What appears to be green seaweed is actually its body."
    },
    {
      "game": "moon",
      "text": "The soul of seaweed adrift in the waves became reborn as this Pokémon. It maintains itself with new infusions of seabed detritus and seaweed."
    },
    {
      "game": "ultra-sun",
      "text": "It wraps its prey in green seaweed and sucks away their vitality. It only likes to go after big prey like Wailord."
    },
    {
      "game": "ultra-moon",
      "text": "Its chain-like green seaweed can stretch outward for hundreds of yards. For some reason, it gets along well with Skrelp."
    },
    {
      "game": "sword",
      "text": "After a piece of seaweed merged with debris from a sunken ship, it was reborn as this ghost Pokémon."
    },
    {
      "game": "shield",
      "text": "After lowering its anchor, it waits for its prey. It catches large Wailord and drains their life-force."
    }
  ],
