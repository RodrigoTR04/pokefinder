  "flavor_texts": [
    {
      "game": "sun",
      "text": "A skillful dancer, it creates a sequence of water balloons as it dances, and briskly bombards its enemies."
    },
    {
      "game": "moon",
      "text": "It cares deeply for its companions. When its Trainer is feeling down, it performs a cheery dance to try and help."
    },
    {
      "game": "ultra-sun",
      "text": "It gets excited when it sees a dance it doesn’t know. This hard worker practices diligently until it can learn that dance."
    },
    {
      "game": "ultra-moon",
      "text": "It attacks by smacking its enemies with the exploding water balloons that it creates."
    },
    {
      "game": "sword",
      "text": "As if dancing, it artfully dodges the attacks of its enemies. All the while, it’s busy forming a bunch of balloons to overwhelm its foes."
    },
    {
      "game": "shield",
      "text": "On nights when the sea is calm, Brionne dance with one another to the singing of the Primarina that’s leading them."
    }
  ],
