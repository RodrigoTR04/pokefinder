  "flavor_texts": [
    {
      "game": "sun",
      "text": "A bit of a dandy, it spends its free time preening its wings. Its preoccupation with any dirt on its plumage can leave it unable to battle."
    },
    {
      "game": "moon",
      "text": "It throws sharp feathers called blade quills at enemies or prey. It seldom misses."
    },
    {
      "game": "ultra-sun",
      "text": "This narcissistic Pokémon is a clean freak. If you don’t groom it diligently, it will stop listening to you."
    },
    {
      "game": "ultra-moon",
      "text": "Supremely sensitive to the presence of others, it can detect opponents standing behind it, flinging its sharp feathers to take them out."
    },
    {
      "game": "sword",
      "text": "It throws one knifelike feather after another at its enemies, and each one precisely strikes a weak point. These feathers are known as blade quills."
    },
    {
      "game": "shield",
