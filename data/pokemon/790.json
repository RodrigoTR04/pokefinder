  "flavor_texts": [
    {
      "game": "sun",
      "text": "Motionless as if dead, its body is faintly warm to the touch. In the distant past, it was called the cocoon of the stars."
    },
    {
      "game": "moon",
      "text": "There’s something accumulating around the black core within its hard shell. People think this Pokémon may come from another world."
    },
    {
      "game": "ultra-sun",
      "text": "The king who ruled Alola in times of antiquity called it the “cocoon of the stars” and built an altar to worship it."
    },
    {
      "game": "ultra-moon",
      "text": "As it absorbs light, Cosmoem continues to grow. Its golden shell is surprisingly solid."
    },
    {
      "game": "sword",
      "text": "The absorption of starlight fuels this Pokémon’s growth. The shell that encases it is harder than any known material."
    },
    {
      "game": "shield",
      "text": "It sucks in dust from the air at an astounding rate, frantically building up energy within its core as preparation for evolution."
    }
  ],
