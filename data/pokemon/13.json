  "flavor_texts": [
    {
      "game": "red",
      "text": "Often found in forests, eating leaves. It has a sharp venomous stinger on its head."
    },
    {
      "game": "blue",
      "text": "Often found in forests, eating leaves. It has a sharp venomous stinger on its head."
    },
    {
      "game": "yellow",
      "text": "Beware of the sharp stinger on its head. It hides in grass and bushes where it eats leaves."
    },
    {
      "game": "gold",
      "text": "Its poison stinger is very powerful. Its bright-colored body is intended to warn off its enemies."
    },
    {
      "game": "silver",
      "text": "It attacks using a two-inch poison barb on its head. It can usually be found under the leaves it eats."
    },
    {
      "game": "crystal",
      "text": "The barb on top of its head secretes a strong poison. It uses this toxic barb to protect itself."
    },
    {
      "game": "ruby",
      "text": "WEEDLE has an extremely acute sense of smell. It is capable of distinguishing its favorite kinds of leaves from those it dislikes just by sniffing with its big red proboscis (nose)."
    },
    {
      "game": "sapphire",
      "text": "WEEDLE has an extremely acute sense of smell. It is capable of distinguishing its favorite kinds of leaves from those it dislikes just by sniffing with its big red proboscis (nose)."
    },
    {
      "game": "emerald",
      "text": "A WEEDLE has an extremely acute sense of smell. It distinguishes its favorite kinds of leaves from those it dislikes by sniffing with its big red proboscis (nose)."
    },
    {
      "game": "firered",
      "text": "Often found in forests and grasslands. It has a sharp, toxic barb of around two inches on top of its head."
    },
    {
      "game": "leafgreen",
      "text": "Often found in forests, eating leaves. It has a sharp stinger on its head that injects poison."
    },
    {
      "game": "diamond",
      "text": "It eats its weight in leaves every day. It fends off attackers with the needle on its head."
    },
    {
      "game": "pearl",
      "text": "It eats its weight in leaves every day. It fends off attackers with the needle on its head."
    },
    {
      "game": "platinum",
      "text": "It eats its weight in leaves every day. It fends off attackers with the needle on its head."
    },
