  "flavor_texts": [
    {
      "game": "sun",
      "text": "Possessed people controlled by this Pokémon transformed its sand mound into a castle. As it evolved, its power to curse grew ever stronger."
    },
    {
      "game": "moon",
      "text": "Buried beneath the castle are masses of dried-up bones from those whose vitality it has drained."
    },
    {
      "game": "ultra-sun",
      "text": "Each of its grains of sand has its own will. Palossand eats small Pokémon and siphons away their vital essence while they’re still alive."
    },
    {
      "game": "ultra-moon",
      "text": "Once it has whipped up a sandstorm to halt its opponents in their tracks, this terrifying Pokémon snatches away their vitality."
    },
    {
      "game": "sword",
      "text": "Palossand is known as the Beach Nightmare. It pulls its prey down into the sand by controlling the sand itself, and then it sucks out their souls."
    },
    {
      "game": "shield",
      "text": "This Pokémon lives on beaches, but it hates water. Palossand can’t maintain its castle-like shape if it gets drenched by a heavy rain."
    }
  ],
