  "flavor_texts": [
    {
      "game": "ruby",
      "text": "SILCOON tethers itself to a tree branch using silk to keep from falling. There, this POKéMON hangs quietly while it awaits evolution. It peers out of the silk cocoon through a small hole."
    },
    {
      "game": "sapphire",
      "text": "SILCOON was thought to endure hunger and not consume anything before its evolution. However, it is now thought that this POKéMON slakes its thirst by drinking rainwater that collects on its silk."
    },
    {
      "game": "emerald",
      "text": "It prepares for evolution using the energy it stored while it was a WURMPLE. It keeps watch over the surroundings with its two eyes."
    },
    {
      "game": "firered",
      "text": "It conserves its energy by moving as little as possible. It awaits evolution while drinking only a little rainwater."
    },
    {
      "game": "leafgreen",
      "text": "It conserves its energy by moving as little as possible. It awaits evolution while drinking only a little rainwater."
    },
    {
      "game": "diamond",
      "text": "It anchors itself by wrapping twigs with the silk from its body. It motionlessly awaits evolution."
    },
    {
      "game": "pearl",
      "text": "It drinks dew that collects on its silk and waits for evolution. Its hard cocoon repels attacks."
    },
    {
      "game": "platinum",
      "text": "It wraps silk around the branches of a tree. It drinks rainwater on its silk while awaiting evolution."
    },
    {
      "game": "heartgold",
      "text": "Having wrapped silk around the branches of a tree, it quiescently awaits evolution."
    },
