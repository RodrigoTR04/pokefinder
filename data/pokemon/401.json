  "flavor_texts": [
    {
      "game": "diamond",
      "text": "It shakes its head back to front, causing its antennae to hit each other and sound like a xylophone."
    },
    {
      "game": "pearl",
      "text": "It chats with others using the sounds of its colliding antennae. These sounds are fall hallmarks."
    },
    {
      "game": "platinum",
      "text": "Its legs are short. Whenever it stumbles, its stiff antennae clack with a xylophone-like sound."
    },
    {
      "game": "heartgold",
      "text": "When its antennae hit each other, it sounds like the music of a xylophone."
