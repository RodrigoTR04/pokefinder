  "flavor_texts": [
    {
      "game": "sun",
      "text": "It crawls onto the land in search of food. Its water bubble allows it to breathe and protects its soft head."
    },
    {
      "game": "moon",
      "text": "When it comes across enemies or potential prey, this Pokémon smashes its water-bubble-covered head into them."
    },
    {
      "game": "ultra-sun",
      "text": "When two Dewpider meet, they display their water bubbles to each other. Then the one with the smaller bubble gets out of the other’s way."
    },
    {
      "game": "ultra-moon",
      "text": "It can only breathe oxygen that has dissolved in water, so it wears a water bubble on its head when it walks around on land."
    },
    {
      "game": "sword",
      "text": "It forms a water bubble at the rear of its body and then covers its head with it. Meeting another Dewpider means comparing water-bubble sizes."
    },
    {
      "game": "shield",
      "text": "Dewpider normally lives underwater. When it comes onto land in search of food, it takes water with it in the form of a bubble on its head."
    }
  ],
