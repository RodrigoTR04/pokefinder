  "flavor_texts": [
    {
      "game": "sun",
      "text": "It expresses its feelings by smacking its scales. Metallic sounds echo through the tall mountains where Jangmo-o lives."
    },
    {
      "game": "moon",
      "text": "They live in mountains where no trace of humans can be detected. Jangmo-o grow little by little as they battle one another."
    },
    {
      "game": "ultra-sun",
      "text": "It smacks the scales on its head against rocks or against the ground to frighten its opponents. It can also contact its friends with these noises."
    },
    {
      "game": "ultra-moon",
      "text": "It will never show an enemy its back in battle. Ancient warriors liked Jangmo-o for its valiant disposition and made it one of their own."
    },
    {
      "game": "sword",
      "text": "They learn to fight by smashing their head scales together. The dueling strengthens both their skills and their spirits."
    },
    {
      "game": "shield",
      "text": "Jangmo-o strikes its scales to communicate with others of its kind. Its scales are actually fur that’s become as hard as metal."
    }
  ],
