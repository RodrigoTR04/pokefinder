  "flavor_texts": [
    {
      "game": "sun",
      "text": "It is born asleep, and it dies asleep. All its movements are apparently no more than the results of it tossing and turning in its dreams."
    },
    {
      "game": "moon",
      "text": "The log it holds was given to it by its parents at birth. It has also been known to cling to the arm of a friendly Trainer."
    },
    {
      "game": "ultra-sun",
      "text": "It stays asleep from the moment it’s born. When it falls into a deep sleep, it stops moving altogether."
    },
    {
      "game": "ultra-moon",
      "text": "It remains asleep from birth to death as a result of the sedative properties of the leaves that form its diet."
    }
