  "flavor_texts": [
    {
      "game": "sun",
      "text": "At its throat, it bears a bell of fire. The bell rings brightly whenever this Pokémon spits fire."
    },
    {
      "game": "moon",
      "text": "It boasts powerful front legs. With a single punch, it can bend an iron bar right over."
    },
    {
      "game": "ultra-sun",
      "text": "It can act spoiled if it grows close to its Trainer. A powerful Pokémon, its sharp claws can leave its Trainer’s whole body covered in scratches."
    },
    {
      "game": "ultra-moon",
      "text": "When its mane is standing on end, you can tell it’s feeling good. When it isn’t feeling well, its fur will lie down flat."
    },
    {
      "game": "sword",
      "text": "In the midst of battle, the fire pouch on Torracat’s neck rings like a bell and produces stronger flames than usual."
    },
    {
      "game": "shield",
      "text": "When facing a powerful enemy, Torracat’s fighting spirit gets pumped up, and its fire bell blazes hotter."
    }
  ],
