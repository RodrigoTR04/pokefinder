  "flavor_texts": [
    {
      "game": "sun",
      "text": "With its sharp fangs, it will bite anything. It did not originally live in Alola but was imported from another region."
    },
    {
      "game": "moon",
      "text": "It wanders around in a never-ending search for food. At dusk, it collapses from exhaustion and falls asleep on the spot."
    },
    {
      "game": "ultra-sun",
      "text": "Its stomach takes up most of its long torso. It’s a big eater, so the amount Trainers have to spend on its food is no laughing matter."
    },
    {
      "game": "ultra-moon",
      "text": "Although it will eat anything, it prefers fresh living things, so it marches down streets in search of prey."
    }
