  "flavor_texts": [
    {
      "game": "sun",
      "text": "The shell on its back is chemically unstable and explodes violently if struck. The hole in its stomach is its weak point."
    },
    {
      "game": "moon",
      "text": "It gushes fire and poisonous gases from its nostrils. Its dung is an explosive substance and can be put to various uses."
    },
    {
      "game": "ultra-sun",
      "text": "It lives in volcanoes and eats sulfur and other minerals. Materials from the food it eats form the basis of its explosive shell."
    },
    {
      "game": "ultra-moon",
      "text": "Its exploding shell poses a real danger but is sensitive to moisture. On rainy days, Turtonator takes silent refuge in caves."
    },
    {
      "game": "sword",
      "text": "Explosive substances coat the shell on its back. Enemies that dare attack it will be blown away by an immense detonation."
    },
    {
      "game": "shield",
      "text": "Eating sulfur in its volcanic habitat is what causes explosive compounds to develop in its shell. Its droppings are also dangerously explosive."
    }
  ],
