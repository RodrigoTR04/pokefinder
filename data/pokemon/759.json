  "flavor_texts": [
    {
      "game": "sun",
      "text": "Despite its adorable appearance, when it gets angry and flails about, its arms and legs could knock a pro wrestler sprawling."
    },
    {
      "game": "moon",
      "text": "A touch from anyone except a known friend sends it into a surging frenzy. It’s an incredibly dangerous Pokémon."
    },
    {
      "game": "ultra-sun",
      "text": "It boasts power enough to split large trees in half. The organ on its rear releases an odor that it uses to communicate with others of its kind."
    },
    {
      "game": "ultra-moon",
      "text": "Stufful hates to be hugged or touched in any way. It will squirm, thrash, and resist with amazing power."
    },
    {
      "game": "sword",
      "text": "Its fluffy fur is a delight to pet, but carelessly reaching out to touch this Pokémon could result in painful retaliation."
    },
    {
      "game": "shield",
      "text": "The way it protects itself by flailing its arms may be an adorable sight, but stay well away. This is flailing that can snap thick tree trunks."
    }
  ],
