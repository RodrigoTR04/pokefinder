  "flavor_texts": [
    {
      "game": "sun",
      "text": "It spits a mud that provides resistance to both wind and rain, so the walls of old houses were often coated with it."
    },
    {
      "game": "moon",
      "text": "Its heavy, mud-covered kicks are its best means of attack, and it can reduce large trucks to scrap without breaking a sweat."
    },
    {
      "game": "ultra-sun",
      "text": "It remains calm and unmoving no matter the situation. It mixes dirt with the saliva in its mouth to make a special kind of mud."
    },
    {
      "game": "ultra-moon",
      "text": "It can trudge mountain roads without rest for three days and three nights, all the while dragging a 10-ton load."
    },
