  "flavor_texts": [
    {
      "game": "sun",
      "text": "The dense fog it creates brings the downfall and destruction of its confused enemies. Ocean currents are the source of its energy."
    },
    {
      "game": "moon",
      "text": "The guardian deity of Poni, it can control water. People say it can create pure water that will wash away any uncleanness."
    },
    {
      "game": "ultra-sun",
      "text": "This guardian deity of Poni Island manipulates water. Because it lives deep within a thick fog, it came to be both feared and revered."
    },
    {
      "game": "ultra-moon",
      "text": "Although it’s called a guardian deity, terrible calamities sometimes befall those who recklessly approach Tapu Fini."
    }
  ],
