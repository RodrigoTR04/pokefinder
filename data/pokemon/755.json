  "flavor_texts": [
    {
      "game": "sun",
      "text": "It scatters spores that flicker and glow. Anyone seeing these lights falls into a deep slumber."
    },
    {
      "game": "moon",
      "text": "As it drowses the day away, it nourishes itself by sucking from tree roots. It wakens at the fall of night, wandering off in search of a new tree."
    },
    {
      "game": "ultra-sun",
      "text": "It scatters its shining spores around itself. Even though they’re dangerous, nighttime tours of forests where Morelull live are popular."
    },
    {
      "game": "ultra-moon",
      "text": "It likes damp dark places. When night falls, the spores filling the caps of its mushrooms glow."
    },
    {
      "game": "sword",
      "text": "Pokémon living in the forest eat the delicious caps on Morelull’s head. The caps regrow overnight."
    },
    {
      "game": "shield",
      "text": "Morelull live in forests that stay dark even during the day. They scatter flickering spores that put enemies to sleep."
    }
  ],
