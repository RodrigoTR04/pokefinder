  "flavor_texts": [
    {
      "game": "red",
      "text": "This POKéMON is vulnerable to attack while its shell is soft, exposing its weak and tender body."
    },
    {
      "game": "blue",
      "text": "This POKéMON is vulnerable to attack while its shell is soft, exposing its weak and tender body."
    },
    {
      "game": "yellow",
      "text": "Hardens its shell to protect itself. However, a large impact may cause it to pop out of its shell."
    },
    {
      "game": "gold",
      "text": "Inside the shell, it is soft and weak as it pre­ pares to evolve. It stays motion­ less in the shell."
    },
    {
      "game": "silver",
      "text": "It prepares for evolution by har­ dening its shell as much as possi­ ble to protect its soft body."
    },
