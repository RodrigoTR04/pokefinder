  "flavor_texts": [
    {
      "game": "sun",
      "text": "With a flashing slash of its giant sharp claws, it cleaves seawater—or even air—right in two."
    },
    {
      "game": "moon",
      "text": "It battles skillfully with its six arms, but spends most of its time peacefully meditating in caves deep beneath the sea."
    },
    {
      "game": "ultra-sun",
      "text": "The shell covering its body is as hard as diamond. This Pokémon will do anything it takes to win."
    },
    {
      "game": "ultra-moon",
      "text": "Its claws, which it can extend and retract at will, are its greatest weapons. Golisopod is sometimes accompanied by Wimpod."
    },
    {
      "game": "sword",
      "text": "It will do anything to win, taking advantage of every opening and finishing opponents off with the small claws on its front legs."
    },
    {
      "game": "shield",
      "text": "They live in sunken ships or in holes in the seabed. When Golisopod and Grapploct battle, the loser becomes the winner’s meal."
    }
  ],
